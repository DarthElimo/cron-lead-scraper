# =============================================================================
# DATAFORSEO — Google Maps Scraping
# =============================================================================
# 1. Gehe auf https://app.dataforseo.com/register und erstelle einen Account
# 2. Nach dem Login: Dashboard → API → deine E-Mail-Adresse und dein Passwort eintragen
# 3. DataForSEO gibt dir $1 Startguthaben gratis (reicht für hunderte von Leads)
DATAFORSEO_LOGIN=deine-email@example.com
DATAFORSEO_PASSWORD=dein-dataforseo-passwort

# =============================================================================
# GOOGLE SHEETS — Wo die Leads gespeichert werden
# =============================================================================
# Service Account erstellen:
# 1. Gehe auf https://console.cloud.google.com
# 2. Neues Projekt erstellen (oder bestehendes wählen)
# 3. APIs & Services → Library → "Google Sheets API" suchen und aktivieren
# 4. APIs & Services → Credentials → "Create Credentials" → "Service Account"
# 5. Name vergeben, auf "Done" klicken
# 6. Auf den erstellten Service Account klicken → Reiter "Keys" → "Add Key" → "JSON"
# 7. Die JSON-Datei wird runtergeladen — daraus brauchst du "client_email" und "private_key"
GOOGLE_SERVICE_ACCOUNT_EMAIL=dein-service-account@dein-projekt.iam.gserviceaccount.com

# Den private_key aus der JSON-Datei kopieren (inkl. "-----BEGIN PRIVATE KEY-----" usw.)
# Wichtig: Die Zeilenumbrüche durch \n ersetzen, alles in einer Zeile
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDEIN_KEY_HIER\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID:
# 1. Öffne dein Google Sheet (oder erstelle ein neues)
# 2. Die ID steht in der URL: https://docs.google.com/spreadsheets/d/HIER_STEHT_DIE_ID/edit
# 3. Gib dem Service Account Zugriff: Im Sheet auf "Teilen" klicken → Service Account E-Mail eintragen
GOOGLE_SPREADSHEET_ID=deine-spreadsheet-id

# =============================================================================
# TRIGGER.DEV — Automatisierungs-Plattform
# =============================================================================
# 1. Gehe auf https://trigger.dev und erstelle einen kostenlosen Account
# 2. Neues Projekt erstellen
# 3. Project Settings → API Keys → deinen Secret Key kopieren
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# GROQ — High-Ticket-Klassifikation (kostenlos)
# =============================================================================
# Wird für die SHK-High-Ticket-Klassifikation genutzt (nur für Grenzfälle, der
# Rest läuft lokal per Keyword-Scorer). Groq Free Tier ist kommerziell erlaubt
# und trainiert nicht auf deinen Daten.
# 1. Gehe auf https://console.groq.com und erstelle einen kostenlosen Account
# 2. API Keys → "Create API Key" → kopieren
# Optional: Ohne Key läuft die Klassifikation rein keyword-basiert weiter.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
